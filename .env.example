# Configuração do Firebase (PRD seção 7). Copie para `.env` e preencha.
# Sem estas variáveis o app roda offline: jogo local funciona, mas login e
# ranking global ficam desabilitados.
#
# Valores em: Console do Firebase > Configurações do projeto > Seus apps (Web).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
