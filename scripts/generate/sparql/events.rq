# Eventos históricos com data (modo Linha do tempo). P585=ponto no tempo,
# P580=data de início. Fatiado por faixa de ano (__MIN__/__MAX__).
SELECT DISTINCT ?item ?itemLabel ?year ?image ?countryLabel ?countryCode WHERE {
  ?item wdt:P31/wdt:P279* wd:Q1190554 .   # ocorrência / evento
  OPTIONAL { ?item wdt:P585 ?pit. }
  OPTIONAL { ?item wdt:P580 ?start. }
  BIND(YEAR(COALESCE(?pit, ?start)) AS ?year)
  OPTIONAL { ?item wdt:P18 ?image. }
  OPTIONAL {
    ?item wdt:P17 ?country .
    ?country wdt:P298 ?countryCode .
  }
  FILTER(BOUND(?year) && ?year >= __MIN__ && ?year < __MAX__)
  SERVICE wikibase:label { bd:serviceParam wikibase:language "pt,en". }
}
LIMIT __LIMIT__
