# Cidades com população, país e coordenadas (modos Maior ou menor, De que país
# é; coordenada P625 reservada para o modo WhenTaken futuro).
# Fatiado por faixa de POPULAÇÃO (__MIN__/__MAX__) para não estourar o timeout.
SELECT DISTINCT ?item ?itemLabel ?population ?image ?countryLabel ?countryCode ?coord WHERE {
  ?item wdt:P31/wdt:P279* wd:Q515 ;   # instância de cidade (ou subclasse)
        wdt:P1082 ?population ;
        wdt:P17 ?country .
  ?country wdt:P298 ?countryCode .
  OPTIONAL { ?item wdt:P18 ?image. }
  OPTIONAL { ?item wdt:P625 ?coord. }
  FILTER(?population >= __MIN__ && ?population < __MAX__)
  SERVICE wikibase:label { bd:serviceParam wikibase:language "pt,en". }
}
LIMIT __LIMIT__
